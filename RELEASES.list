# ============================================================================
# Published artifacts - single source of truth for --list-releases, --download
# and --deploy. Maintain this file by hand; no scripting or API calls needed.
#
# Format (whitespace separated, one artifact per line):
#
#     <target>    <version>    <artifact>
#
#   target   : tt-host | tt-stack | therock
#              (CLI aliases: tenstorrent = tt-stack, amd = therock)
#   version  : release tag, e.g. v0.1.0
#   artifact : full .deb file name, or full docker tag (short name, WITHOUT the
#              RVOCS_REGISTRY prefix)
#
# ORDER: newest first. To publish a new version, insert its lines ABOVE the
# older ones. --download and --deploy always pick the first (newest) version
# that has an artifact matching --arch.
#
# Where the artifacts live:
#   images : <RVOCS_REGISTRY>/<artifact>  (Huawei Cloud SWR, public)
#   .deb   : <RVOCS_TT_HOST_RELEASES_PAGE>/download/<version>/<artifact>
#            (GitHub Releases of rvocs-hcs-tenstorrent)
# ============================================================================

tt-host     v0.1.0    rvocs-tt-deps_v0.1.0_riscv64.deb
tt-host     v0.1.0    rvocs-tt-deps_v0.1.0_amd64.deb

tt-stack    v0.1.0    rvocs-vllm-tt-riscv64:v0.1.0
tt-stack    v0.1.0    rvocs-vllm-tt-amd64:v0.1.0

therock     v0.1.0    rvocs-vllm-therock10.0-r9700-riscv64:v0.1.0
